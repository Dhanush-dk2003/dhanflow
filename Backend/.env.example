NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional AI (Ask DhanFlow + reading messy statements). Leave AI_API_KEY empty to turn it off.
# gemini (default): free key at https://aistudio.google.com/apikey
# groq: free key at https://console.groq.com/keys
# ollama: runs on your own computer, no key needed
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides: a different model name, or any OpenAI-compatible endpoint
# AI_MODEL=gemini-3.8-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Models to switch to when the main one hits its free limit (Gemini default: gemini-3.1-flash-lite)
# AI_FALLBACK_MODELS=gemini-3.1-flash-lite
